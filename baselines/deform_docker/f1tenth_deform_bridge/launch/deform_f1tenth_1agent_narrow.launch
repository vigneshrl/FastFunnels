<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="target_episodes" default="1"/>
  <arg name="episode_timeout_s" default="90.0"/>

  <node name="f1tenth_bridge" pkg="f1tenth_deform_bridge"
        type="f1tenth_bridge_node.py" output="screen" required="true">
    <rosparam file="/root/DEFORM/src/utility/f1tenth_deform_bridge/config/bridge_params.yaml"
              command="load" ns="~"/>
    <param name="num_agents" value="1"/>
    <param name="map_name" value="open_narrow_obs"/>
    <param name="tb_num" value="1"/>
    <param name="target_episodes" value="$(arg target_episodes)"/>
    <param name="episode_timeout_s" value="$(arg episode_timeout_s)"/>
  </node>

  <include file="$(find plan_manager)/launch/one_run.xml">
    <arg name="tb_id" value="0"/>
    <arg name="tb_num" value="1"/>
    <arg name="frm_type" value="1"/>
    <arg name="other_num_in_opti" value="0"/>
  </include>

  <node name="rviz" pkg="rviz" type="rviz" output="screen"
        args="-d /root/DEFORM/src/utility/f1tenth_deform_bridge/config/deform_rviz.rviz"/>
</launch>
